<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://tv-home.local" version="0.4.0" width="1920" height="1080" viewmodes="maximized">
  <tizen:application id="TvHome0001.TVHome" package="TvHome0001" required_version="6.0"/>
  <tizen:profile name="tv-samsung"/>
  <name>TVHome</name>
  <content src="index.html"/>
  <icon src="images/icon.png"/>
  <!-- Network access (WARP): only the Open-Meteo hosts used for weather. Website tiles open in the
       TV browser through an application control, which is not a network request from this app. -->
  <access origin="https://api.open-meteo.com" subdomains="false"/>
  <access origin="https://geocoding-api.open-meteo.com" subdomains="false"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <tizen:privilege name="http://tizen.org/privilege/application.info"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
